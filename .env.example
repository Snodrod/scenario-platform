# --- Supabase ---
# Create a project at https://supabase.com, then Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the browser.
# Used for admin invites and to bypass RLS from trusted API routes.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers ---
# Used for script -> scenes/shots breakdown (and future text tasks)
OPENAI_API_KEY=
# Used for image generation (Nano Banana / Gemini image models)
GOOGLE_API_KEY=

# Reserved for Phase 3 (voiceover). Leave blank for now.
ELEVENLABS_API_KEY=

# --- Script import (optional) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). Add {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
# as an authorized redirect URI. File upload and public Google Doc link
# import work without this — only the "pick from Drive" option needs it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# notion.so/my-integrations → New integration → Internal Integration
# Secret. Then open each page you want to import → "..." → Connections
# → add your integration (per page, Notion doesn't have a workspace-wide
# grant for internal integrations).
NOTION_API_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
